@startuml@startumlclass Passager {    - id : int    - nom : string    - prenom : string    - passeport : string    + afficher()}class Vol {    - numeroVol : string    - origine : string    - destination : string    - capacite : int    - prix : double    - placesReservees : int    + estDisponible() : bool    + reserverPlace()    + libererPlace()}class Reservation {    - id : int    - statut : string    + confirmer()    + annuler()}class Paiement {    - id : int    - montant : double    - mode : string    - statut : string}class Agence {    - passagers : vector<Passager>    - vols : vector<Vol>    - reservations : vector<Reservation>    - paiements : vector<Paiement>    - compteurPassager : int    - compteurRes : int    - compteurPay : int    + enregistrerPassager()    + ajouterVol()    + afficherVolsDisponibles()    + rechercherVol()    + effectuerReservation()    + enregistrerPaiement()    + annulerReservation()    + consulterReservations()    + afficherUneReservation()    - trouverPassager(id : int) : int    - trouverVol(numero : string) : int    - trouverReservation(id : int) : int}Agence "1" -- "*" PassagerAgence "1" -- "*" VolAgence "1" -- "*" ReservationAgence "1" -- "*" PaiementPassager "1" -- "*" ReservationVol "1" -- "*" ReservationReservation "1" -- "1" Paiement@enduml@enduml